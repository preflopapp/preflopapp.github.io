# Wrangler writes account metadata and deploy caches here. Never commit it,
# and never let it reach a deployment: Pages publishes every file it uploads,
# dotfiles included.
.wrangler/

# Python build artifacts
__pycache__/

# Staging directory the deploy assembles; see .github/workflows/deploy.yml
_site/

# Claude Code: share rules, skills, hooks and commands; keep local state out.
# launch.json holds this machine's scratchpad path.
.claude/worktrees/
.claude/settings.local.json
.claude/launch.json
