/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=604800

# The redesign's CSS and JS. Every page names them with ?v=<hash of the file>
# (scripts/stamp-assets.py; check-site.py fails a missing or stale stamp), so
# a changed file gets a new URL and the old one can be cached for good. Only
# these two folders: /next/* would also freeze any page put under /next/, and
# /assets/* has URLs that JS builds, unstamped (ISSUES LIVE-02, SPEC §4.8).
/next/css/*
  Cache-Control: public, max-age=31536000, immutable

/next/js/*
  Cache-Control: public, max-age=31536000, immutable

# Shared-hand page (/s/<spot id>): it enforces its own
# hash-pinned CSP in its <head>, since it decodes the hand in a script.
/s
  ! Content-Security-Policy
  X-Frame-Options: DENY

/s/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

# The homepage (the redesigned site, cut over from /next/ in Phase 5). Like
# /s it enforces its own CSP in its <head>, script-src 'self' for
# next/js; the site-wide header would add script-src
# 'none'. Only the exact path: every other page keeps the site-wide policy.
/
  ! Content-Security-Policy
  X-Frame-Options: DENY

# The text pages (FAQ, support, press, privacy, terms) share the homepage's nav and
# footer, so they run site.js under their own script-src 'self' page CSP too.
/faq
  ! Content-Security-Policy
  X-Frame-Options: DENY

/faq/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

/support
  ! Content-Security-Policy
  X-Frame-Options: DENY

/support/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

/press
  ! Content-Security-Policy
  X-Frame-Options: DENY

/press/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

/privacy
  ! Content-Security-Policy
  X-Frame-Options: DENY

/privacy/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

/terms
  ! Content-Security-Policy
  X-Frame-Options: DENY

/terms/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

# No page is left under /next/ (the style guide went in redesign Phase 6;
# /next/ redirects to /), only its CSS and JS. Kept so a page put there again
# is noindex and, like /s, enforces its own CSP in its <head>, here
# script-src 'self' for next/js; no inline scripts. The
# header would otherwise add script-src 'none'. X-Robots-Tag keeps it out of
# search results even if a page forgets its noindex meta.
/next
  ! Content-Security-Policy
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

/next/*
  ! Content-Security-Policy
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow

# Universal Links: iOS fetches this to let preflopapp.com/s/* open the app.
# It has to be JSON, served without a redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Which plans the app's paywall offers (PaywallLineup in the app repo). The
# app reads it at launch; a short cache so a switch reaches users within
# minutes. Names: monthly, annual, lifetime. Order = paywall order.
/paywall.json
  Cache-Control: public, max-age=300
  Content-Type: application/json
