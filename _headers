/*
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

/assets/*
  Cache-Control: public, max-age=604800

# The landing page enforces a hash-pinned CSP in its <head>. The site's
# script-src 'none' header would otherwise block its interactive demo.
# X-Frame-Options supplies the frame protection unavailable to meta CSP.
/landing
  ! Content-Security-Policy
  X-Frame-Options: DENY

/landing/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

# Shared-hand page (/s/<spot id>): like the landing page, it enforces its own
# hash-pinned CSP in its <head>, since it decodes the hand in a script.
/s
  ! Content-Security-Policy
  X-Frame-Options: DENY

/s/*
  ! Content-Security-Policy
  X-Frame-Options: DENY

# Universal Links: iOS fetches this to let preflopapp.com/s/* open the app.
# It has to be JSON, served without a redirect.
/.well-known/apple-app-site-association
  Content-Type: application/json

# Which plans the app's paywall offers (PaywallLineup in the app repo). The
# app reads it at launch; a short cache so a switch reaches users within
# minutes. Names: monthly, annual, lifetime. Order = paywall order.
/paywall.json
  Cache-Control: public, max-age=300
  Content-Type: application/json
